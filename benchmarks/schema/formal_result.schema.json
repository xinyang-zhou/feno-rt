{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xinyang-zhou/feno-rt/benchmarks/schema/formal_result.schema.json",
  "title": "FENO-RT formal benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result_class",
    "status",
    "benchmark",
    "run_id",
    "repeat_index",
    "created_at_utc",
    "source",
    "environment",
    "model",
    "workload",
    "execution",
    "timing",
    "metrics",
    "correctness",
    "artifacts",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "result_class": {"const": "formal"},
    "status": {"enum": ["passed", "failed"]},
    "benchmark": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$"},
    "repeat_index": {"type": "integer", "minimum": 1},
    "created_at_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "git_dirty",
        "command",
        "config_path",
        "config_sha256"
      ],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "git_dirty": {"const": false},
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "config_path": {"type": "string", "minLength": 1},
        "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hardware", "software", "environment_variables"],
      "properties": {
        "hardware": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "gpus",
            "system_gpu_count",
            "visible_cuda_device_count",
            "cpu_model",
            "logical_cpu_count",
            "cpu_affinity",
            "system_memory_bytes",
            "other_gpu_processes"
          ],
          "properties": {
            "gpus": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "logical_index",
                  "physical_index",
                  "name",
                  "uuid",
                  "total_memory_bytes",
                  "persistence_mode",
                  "power_limit_watts",
                  "application_clocks"
                ],
                "properties": {
                  "logical_index": {"type": "integer", "minimum": 0},
                  "physical_index": {"type": ["integer", "null"], "minimum": 0},
                  "name": {"type": "string", "minLength": 1},
                  "uuid": {"type": "string", "minLength": 1},
                  "total_memory_bytes": {"type": "integer", "minimum": 1},
                  "persistence_mode": {"type": ["string", "null"]},
                  "power_limit_watts": {"type": ["number", "null"], "exclusiveMinimum": 0},
                  "application_clocks": {"type": ["string", "null"]}
                }
              }
            },
            "system_gpu_count": {"type": "integer", "minimum": 1},
            "visible_cuda_device_count": {"type": "integer", "minimum": 1},
            "cpu_model": {"type": "string", "minLength": 1},
            "logical_cpu_count": {"type": "integer", "minimum": 1},
            "cpu_affinity": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 0}
            },
            "system_memory_bytes": {"type": "integer", "minimum": 1},
            "other_gpu_processes": {"type": "boolean"}
          }
        },
        "software": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "python",
            "pytorch",
            "cuda_runtime",
            "cudnn",
            "driver",
            "operating_system",
            "kernel",
            "python_executable",
            "torch_num_threads",
            "torch_num_interop_threads",
            "dependency_lock",
            "direct_dependencies"
          ],
          "properties": {
            "python": {"type": "string", "minLength": 1},
            "pytorch": {"type": "string", "minLength": 1},
            "cuda_runtime": {"type": "string", "minLength": 1},
            "cudnn": {"type": ["string", "null"]},
            "driver": {"type": "string", "minLength": 1},
            "operating_system": {"type": "string", "minLength": 1},
            "kernel": {"type": "string", "minLength": 1},
            "python_executable": {"type": "string", "minLength": 1},
            "torch_num_threads": {"type": "integer", "minimum": 1},
            "torch_num_interop_threads": {"type": "integer", "minimum": 1},
            "dependency_lock": {"$ref": "#/$defs/optionalArtifactIdentity"},
            "direct_dependencies": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string", "minLength": 1}
            }
          }
        },
        "environment_variables": {
          "type": "object",
          "additionalProperties": {"type": ["string", "null"]}
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "random_initialized",
        "seed",
        "checkpoint",
        "normalization",
        "config",
        "parameter_count",
        "parameter_dtype"
      ],
      "properties": {
        "random_initialized": {"type": "boolean"},
        "seed": {"type": "integer", "minimum": 0},
        "checkpoint": {"$ref": "#/$defs/optionalArtifactIdentity"},
        "normalization": {"$ref": "#/$defs/optionalArtifactIdentity"},
        "config": {"type": "object"},
        "parameter_count": {"type": "integer", "minimum": 1},
        "parameter_dtype": {"type": "string", "minLength": 1}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema_version",
        "sha256",
        "velocity_sha256",
        "seed",
        "request_count",
        "batch_size",
        "invocation_count",
        "arrival_pattern",
        "cache_state",
        "source_shape",
        "receiver_shape",
        "frequency_shape"
      ],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "velocity_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "seed": {"type": "integer", "minimum": 0},
        "request_count": {"type": "integer", "minimum": 1000},
        "batch_size": {"type": "integer", "minimum": 1},
        "invocation_count": {"type": "integer", "minimum": 1},
        "arrival_pattern": {"type": "string", "minLength": 1},
        "cache_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["medium", "geometry", "wavelet"],
          "properties": {
            "medium": {"enum": ["warm", "cold", "mixed"]},
            "geometry": {"enum": ["warm", "cold", "mixed"]},
            "wavelet": {"enum": ["warm", "cold", "mixed"]}
          }
        },
        "source_shape": {"$ref": "#/$defs/shape"},
        "receiver_shape": {"$ref": "#/$defs/shape"},
        "frequency_shape": {"$ref": "#/$defs/shape"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device",
        "graph_enabled",
        "graph_buckets",
        "selected_graph_bucket",
        "profiler_enabled",
        "warmup_invocations",
        "dtype",
        "tf32_enabled",
        "cudnn_benchmark",
        "deterministic"
      ],
      "properties": {
        "device": {"type": "string", "pattern": "^cuda:[0-9]+$"},
        "graph_enabled": {"type": "boolean"},
        "graph_buckets": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "selected_graph_bucket": {"type": ["integer", "null"], "minimum": 1},
        "profiler_enabled": {"const": false},
        "warmup_invocations": {"type": "integer", "minimum": 1},
        "dtype": {"type": "string", "minLength": 1},
        "tf32_enabled": {"type": "boolean"},
        "cudnn_benchmark": {"type": "boolean"},
        "deterministic": {"type": "boolean"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "clock",
        "synchronization",
        "latency_unit",
        "setup_included",
        "measured_wall_time_seconds",
        "batch_latency_ms"
      ],
      "properties": {
        "clock": {"const": "perf_counter_ns"},
        "synchronization": {"const": "device_before_after"},
        "latency_unit": {"const": "ms"},
        "setup_included": {"const": false},
        "measured_wall_time_seconds": {"type": "number", "exclusiveMinimum": 0},
        "batch_latency_ms": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "number", "minimum": 0}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency", "throughput_requests_per_second", "memory", "cache", "graph"],
      "properties": {
        "latency": {"$ref": "#/$defs/latencySummary"},
        "throughput_requests_per_second": {"type": "number", "exclusiveMinimum": 0},
        "memory": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "baseline_allocated_bytes",
            "peak_allocated_bytes",
            "peak_reserved_bytes",
            "capture_wall_time_ms",
            "capture_allocated_delta_bytes",
            "capture_reserved_delta_bytes"
          ],
          "properties": {
            "baseline_allocated_bytes": {"type": "integer", "minimum": 0},
            "peak_allocated_bytes": {"type": "integer", "minimum": 0},
            "peak_reserved_bytes": {"type": "integer", "minimum": 0},
            "capture_wall_time_ms": {"type": ["number", "null"], "minimum": 0},
            "capture_allocated_delta_bytes": {"type": ["integer", "null"]},
            "capture_reserved_delta_bytes": {"type": ["integer", "null"]}
          }
        },
        "cache": {"type": "object"},
        "graph": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requests",
            "captures",
            "replays",
            "capture_failures",
            "fallbacks",
            "padded_requests",
            "padded_slots",
            "resident_graphs",
            "static_buffer_bytes",
            "measured_requests",
            "measured_captures",
            "measured_replays",
            "measured_capture_failures",
            "measured_fallbacks",
            "measured_padded_requests",
            "measured_padded_slots",
            "measured_replay_rate"
          ],
          "properties": {
            "requests": {"type": "integer", "minimum": 0},
            "captures": {"type": "integer", "minimum": 0},
            "replays": {"type": "integer", "minimum": 0},
            "capture_failures": {"type": "integer", "minimum": 0},
            "fallbacks": {"type": "integer", "minimum": 0},
            "padded_requests": {"type": "integer", "minimum": 0},
            "padded_slots": {"type": "integer", "minimum": 0},
            "resident_graphs": {"type": "integer", "minimum": 0},
            "static_buffer_bytes": {"type": "integer", "minimum": 0},
            "measured_requests": {"type": "integer", "minimum": 0},
            "measured_captures": {"type": "integer", "minimum": 0},
            "measured_replays": {"type": "integer", "minimum": 0},
            "measured_capture_failures": {"type": "integer", "minimum": 0},
            "measured_fallbacks": {"type": "integer", "minimum": 0},
            "measured_padded_requests": {"type": "integer", "minimum": 0},
            "measured_padded_slots": {"type": "integer", "minimum": 0},
            "measured_replay_rate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        }
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "passed",
        "relative_l2_error",
        "max_absolute_error",
        "rtol",
        "atol",
        "output_shape",
        "output_dtype",
        "all_finite"
      ],
      "properties": {
        "passed": {"type": "boolean"},
        "relative_l2_error": {"type": ["number", "null"], "minimum": 0},
        "max_absolute_error": {"type": ["number", "null"], "minimum": 0},
        "rtol": {"type": "number", "minimum": 0},
        "atol": {"type": "number", "minimum": 0},
        "output_shape": {"$ref": "#/$defs/shape"},
        "output_dtype": {"type": "string", "minLength": 1},
        "all_finite": {"type": "boolean"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_path", "workload_path"],
      "properties": {
        "result_path": {"type": "string", "minLength": 1},
        "workload_path": {"type": ["string", "null"]}
      }
    },
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "$defs": {
    "shape": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0}
    },
    "optionalArtifactIdentity": {
      "anyOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["identifier", "sha256"],
          "properties": {
            "identifier": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      ]
    },
    "latencySummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mean_ms", "p50_ms", "p95_ms", "p99_ms", "max_ms"],
      "properties": {
        "mean_ms": {"type": "number", "minimum": 0},
        "p50_ms": {"type": "number", "minimum": 0},
        "p95_ms": {"type": "number", "minimum": 0},
        "p99_ms": {"type": "number", "minimum": 0},
        "max_ms": {"type": "number", "minimum": 0}
      }
    }
  }
}
