{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/xinyang-zhou/feno-rt/benchmarks/schema/graph_ab_config.schema.json",
  "title": "FENO-RT CUDA Graph A/B configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "device",
    "seed",
    "model",
    "workload",
    "measurement",
    "execution",
    "cuda_graph",
    "correctness"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "benchmark": {"const": "cuda_graph_ab"},
    "device": {"type": "string", "pattern": "^cuda:[0-9]+$"},
    "seed": {"type": "integer", "minimum": 0},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_source",
        "model_source",
        "checkpoint_env",
        "normalization_env",
        "dtype"
      ],
      "properties": {
        "config_source": {"const": "default_inference"},
        "model_source": {"const": "checkpoint"},
        "checkpoint_env": {"type": "string", "minLength": 1},
        "normalization_env": {"type": "string", "minLength": 1},
        "dtype": {"const": "float32"}
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "schema_version",
        "request_count",
        "batch_sizes",
        "arrival_pattern",
        "request_sequence",
        "velocity",
        "source_positions",
        "positions_are_normalized",
        "receiver_positions",
        "frequency_hz",
        "cache_state"
      ],
      "properties": {
        "name": {"const": "steady_all_hit"},
        "schema_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "request_count": {"type": "integer", "minimum": 1000},
        "batch_sizes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "arrival_pattern": {"const": "closed_loop"},
        "request_sequence": {"const": "repeat_fixed_batch"},
        "velocity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "generator",
            "z_sine_amplitude",
            "z_cycles",
            "x_cosine_amplitude",
            "x_cycles"
          ],
          "properties": {
            "generator": {"const": "physical_sine_cosine_v1"},
            "z_sine_amplitude": {"type": "number"},
            "z_cycles": {"type": "number", "exclusiveMinimum": 0},
            "x_cosine_amplitude": {"type": "number"},
            "x_cycles": {"type": "number", "exclusiveMinimum": 0}
          }
        },
        "source_positions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "prefixItems": [
              {"type": "number", "minimum": 0},
              {"type": "number", "minimum": 0}
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "positions_are_normalized": {"const": false},
        "receiver_positions": {"const": "model_default"},
        "frequency_hz": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "number", "exclusiveMinimum": 0}
        },
        "cache_state": {
          "type": "object",
          "additionalProperties": false,
          "required": ["medium", "geometry", "wavelet"],
          "properties": {
            "medium": {"const": "warm"},
            "geometry": {"const": "warm"},
            "wavelet": {"const": "warm"}
          }
        }
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_runs",
        "warmup_invocations",
        "clock",
        "synchronization",
        "profiler_enabled",
        "save_raw_batch_latency_samples",
        "record_peak_memory"
      ],
      "properties": {
        "independent_runs": {"type": "integer", "minimum": 3},
        "warmup_invocations": {"type": "integer", "minimum": 1},
        "clock": {"const": "perf_counter_ns"},
        "synchronization": {"const": "device_before_after"},
        "profiler_enabled": {"const": false},
        "save_raw_batch_latency_samples": {"const": true},
        "record_peak_memory": {"const": true}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tf32_enabled",
        "cudnn_benchmark",
        "deterministic_algorithms"
      ],
      "properties": {
        "tf32_enabled": {"type": "boolean"},
        "cudnn_benchmark": {"type": "boolean"},
        "deterministic_algorithms": {"type": "boolean"}
      }
    },
    "cuda_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modes",
        "buckets",
        "warmup_iterations",
        "fallback_on_error",
        "capture_outside_steady_state"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["off", "on"]}
        },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        },
        "warmup_iterations": {"type": "integer", "minimum": 1},
        "fallback_on_error": {"const": false},
        "capture_outside_steady_state": {"const": true}
      }
    },
    "correctness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "rtol", "atol", "require_finite"],
      "properties": {
        "reference": {"const": "eager_same_commit"},
        "rtol": {"type": "number", "minimum": 0},
        "atol": {"type": "number", "minimum": 0},
        "require_finite": {"const": true}
      }
    }
  }
}
